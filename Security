    # -------------------------------------------------
    # Console
    # -------------------------------------------------

    def log(self, message):
        timestamp = datetime.now().strftime("%H:%M:%S")
        line = f"[{timestamp}] {message}\n"

        def update():
            self.console.configure(state="normal")
            self.console.insert("end", line)
            self.console.see("end")
            self.console.configure(state="disabled")

        self.root.after(0, update)

    def clear_log(self):
        self.console.configure(state="normal")
        self.console.delete("1.0", "end")
        self.console.configure(state="disabled")
        self.log("Konsole geleert.")

    # -------------------------------------------------
    # System information
    # -------------------------------------------------

    def system_info(self):
        self.log("=== SYSTEM INFORMATION ===")
        self.log("Betriebssystem: " + platform.system())
        self.log("Version: " + platform.version())
        self.log("Rechner: " + platform.node())
        self.log("Architektur: " + platform.machine())
        self.log("Python: " + platform.python_version())

        try:
            hostname = socket.gethostname()
            local_ip = socket.gethostbyname(hostname)
            self.log("Lokale IP: " + local_ip)
        except OSError:
            self.log("Lokale IP konnte nicht ermittelt werden.")

        if psutil:
            try:
                for name, addresses in psutil.net_if_addrs().items():
                    for address in addresses:
                        if address.family == socket.AF_INET:
                            self.log(
                                f"Netzwerkschnittstelle: {name} "
                                f"-> {address.address}"
                            )
            except Exception as exc:
                self.log(f"Netzwerkdetails nicht verfügbar: {exc}")

        self.log("=== ENDE SYSTEM INFORMATION ===")

    # -------------------------------------------------
    # Local network discovery
    # -------------------------------------------------

    def start_network_scan(self):
        if self.scanning:
            self.log("Ein Scan läuft bereits.")
            return

        if not psutil:
            self.log(
                "Bitte zuerst installieren: py -m pip install psutil"
            )
            return

        interfaces = psutil.net_if_addrs()
        candidates = []

        for addresses in interfaces.values():
            for address in addresses:
                if address.family != socket.AF_INET:
                    continue

                try:
                    ip = ipaddress.ip_address(address.address)
                    if ip.is_private and not ip.is_loopback:
                        candidates.append(str(ip))
                except ValueError:
                    continue

        candidates = list(dict.fromkeys(candidates))

        if not candidates:
            self.log("Keine lokale IPv4-Adresse gefunden.")
            return

        # Kein automatischer Scan des gesamten Subnetzes:
        # Wir prüfen ausschließlich die eigene lokale Adresse.
        self.scanning = True
        self.network_value.config(text="SCANNING")
        self.log("=== LOKALER NETZWERK-CHECK ===")

        threading.Thread(
            target=self._network_worker,
            args=(candidates,),
            daemon=True
        ).start()

    def _network_worker(self, addresses):
        found = 0

        try:
            for ip in addresses:
                self.log(f"Lokale Schnittstelle erkannt: {ip}")
                found += 1

            self.log(
                f"{found} lokale IPv4-Adresse(n) gefunden."
            )
            self.log(
                "Hinweis: Dies ist eine Schnittstellenprüfung, "
                "keine vollständige Router- oder Geräteliste."
            )

        finally:
            self.root.after(
                0,
                lambda: self.network_value.config(text="READY")
            )
            self.scanning = False

    # -------------------------------------------------
    # USB devices
    # -------------------------------------------------

    def scan_usb(self):
        self.log("=== USB DEVICE CHECK ===")

        if platform.system() != "Windows":
            self.log("Dieser USB-Check ist für Windows vorgesehen.")
            return

        try:
            result = subprocess.run(
                [
                    "powershell",
                    "-NoProfile",
                    "-Command",
                    (
                        "Get-PnpDevice -PresentOnly | "
                        "Where-Object { $_.InstanceId -like 'USB*' } | "
                        "Select-Object Class, FriendlyName, Status | "
                        "Format-Table -AutoSize"
                    )
                ],
                capture_output=True,
                text=True,
                timeout=15,
                creationflags=getattr(
                    subprocess, "CREATE_NO_WINDOW", 0
                )
            )

            output = result.stdout.strip()

            if output:
                for line in output.splitlines():
                    self.log(line)
            else:
                self.log("Keine USB-Geräteinformationen verfügbar.")

            if result.stderr.strip():
                self.log("PowerShell meldet: " + result.stderr.strip())

        except Exception as exc:
            self.log(f"USB-Abfrage fehlgeschlagen: {exc}")

        self.log("=== USB CHECK ENDE ===")

    # -------------------------------------------------
    # Android via authorized ADB
    # -------------------------------------------------

    def scan_android(self):
        self.log("=== ANDROID ADB CHECK ===")

        adb = shutil.which("adb")

        if not adb:
            self.log(
                "ADB nicht gefunden. Installiere die offiziellen "
                "Android Platform Tools und füge adb.exe zum PATH hinzu."
            )
            return

        try:
            result = subprocess.run(
                [adb, "devices"],
                capture_output=True,
                text=True,
                timeout=10,
                creationflags=getattr(
                    subprocess, "CREATE_NO_WINDOW", 0
                )
            )

            self.log("ADB-Geräteliste:")

            lines = result.stdout.splitlines()

            for line in lines:
                self.log(line)

            if not any(
                line.strip().endswith("\tdevice")
                for line in lines
            ):
                self.log(
                    "Kein autorisiertes Android-Gerät gefunden. "
                    "USB-Debugging muss aktiviert und der Computer "
                    "am Smartphone bestätigt worden sein."
                )

            if result.stderr.strip():
                self.log(result.stderr.strip())

        except Exception as exc:
            self.log(f"ADB-Abfrage fehlgeschlagen: {exc}")

        self.log("=== ANDROID CHECK ENDE ===")

    # -------------------------------------------------
    # Password audit
    # -------------------------------------------------

    def password_audit(self):
        dialog = tk.Toplevel(self.root)
        dialog.title("JARVIS // Password Audit")
        dialog.configure(bg=BG)
        dialog.geometry("460x250")
        dialog.resizable(False, False)
        dialog.transient(self.root)
        dialog.grab_set()

        tk.Label(
            dialog,
            text="LOCAL PASSWORD AUDIT",
            bg=BG,
            fg=CYAN,
            font=(FONT, 15, "bold")
        ).pack(pady=(20, 12))

        tk.Label(
            dialog,
            text=(
                "Gib ein Testpasswort ein. "
                "Es wird nicht gespeichert oder übertragen."
            ),
            bg=BG,
            fg=WHITE,
            font=(FONT, 9),
            wraplength=400
        ).pack(padx=15, pady=5)

        password_var = tk.StringVar()

        entry = tk.Entry(
            dialog,
            textvariable=password_var,
            show="*",
            bg=PANEL,
            fg=WHITE,
            insertbackground=CYAN,
            font=(FONT, 12),
            relief="flat"
        )
        entry.pack(fill="x", padx=25, pady=12)
        entry.focus_set()

        result_label = tk.Label(
            dialog,
            text="",
            bg=BG,
            fg=GREEN,
            font=(FONT, 10, "bold")
        )
        result_label.pack(pady=5)

        def check_password():
            password = password_var.get()

            if not password:
                result_label.config(
                    text="Bitte ein Testpasswort eingeben.",
                    fg=RED
                )
                return

            score = 0

            if len(password) >= 12:
                score += 1
            if len(password) >= 16:
                score += 1
            if re.search(r"[a-z]", password):
                score += 1
            if re.search(r"[A-Z]", password):
                score += 1
            if re.search(r"\d", password):
                score += 1
            if re.search(r"[^A-Za-z0-9]", password):
                score += 1

            if score <= 2:
                rating = "SCHWACH"
                color = RED
            elif score <= 4:
                rating = "MITTEL"
                color = "#FFD166"
            else:
                rating = "GUT"
                color = GREEN

            result_label.config(
                text=f"Bewertung: {rating} ({score}/6)",
                fg=color
            )

            self.log(
                f"Passwort-Audit abgeschlossen: {rating}. "
                "Das Passwort wurde nicht protokolliert."
            )

        tk.Button(
            dialog,
            text="PASSWORT PRÜFEN",
            command=check_password,
            bg=CYAN,
            fg=BG,
            activebackground=GREEN,
            relief="flat",
            font=(FONT, 10, "bold"),
            padx=15,
            pady=8
        ).pack(pady=8)

        def close_dialog():
            password_var.set("")
            dialog.destroy()

        dialog.protocol("WM_DELETE_WINDOW", close_dialog)

